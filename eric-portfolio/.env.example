# Copy these into your hosting provider's environment settings (do NOT commit real values).
NODE_ENV=production
# Generate with:  npm run set-password   (paste the whole "scrypt$..." line)
ADMIN_PASSWORD_HASH=
# Any long random string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 if your host puts a proxy in front (Render, Railway, Heroku, Nginx...)
TRUST_PROXY=1
# Folder where bookings/posts/subscribers are saved. Point at a persistent disk/volume.
DATA_DIR=./data

# --- Making money ---
# Paystack secret key (Paystack dashboard > Settings > API Keys). Use sk_test_... first, sk_live_... when ready.
PAYSTACK_SECRET_KEY=
# Your public website address, used for the payment return page (no trailing slash)
SITE_URL=https://your-domain.com
# Your WhatsApp number with country code, digits only (shows a chat button on every page). Example: 2348012345678
WHATSAPP_NUMBER=
