# Copy these into your hosting provider's environment settings (do NOT commit real values).
NODE_ENV=production
# Generate with:  npm run set-password   (paste the whole "scrypt$..." line)
ADMIN_PASSWORD_HASH=
# Any long random string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 if your host puts a proxy in front (Render, Railway, Heroku, Nginx...)
TRUST_PROXY=1
# Folder where bookings/posts/subscribers are saved. Point at a persistent disk/volume.
DATA_DIR=./data

# --- Making money ---
# Paystack secret key (Paystack dashboard > Settings > API Keys). Use sk_test_... first, sk_live_... when ready.
PAYSTACK_SECRET_KEY=
# Your public website address, used for the payment return page (no trailing slash)
SITE_URL=https://your-domain.com
# Your WhatsApp number with country code, digits only (shows a chat button on every page). Example: 2348012345678
WHATSAPP_NUMBER=

# --- Email alerts (free: brevo.com) ---
# 1) Create a Brevo account  2) Senders & IP > add your email as a sender and click the link they email you
# 3) SMTP & API > API Keys > create a key
BREVO_API_KEY=
# The sender address you verified in Brevo
MAIL_FROM=
# Where booking alerts go (defaults to MAIL_FROM)
NOTIFY_EMAIL=

# --- Permanent storage (Supabase: free, and your data survives restarts and redeploys) ---
# Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# The SECRET key (starts with sb_secret_ ... or the old "service_role" key). Never put this in the website code or share it.
SUPABASE_SERVICE_KEY=
# Optional: name of the private file bucket (created automatically). Default: site-files
SUPABASE_BUCKET=

# --- Booking alerts through Formspree (simplest) ---
# Your form's address from formspree.io, e.g. https://formspree.io/f/abcd1234
# In the Formspree form settings, turn OFF reCAPTCHA and "Restrict to domain" (this site sends from its server).
FORMSPREE_URL=
